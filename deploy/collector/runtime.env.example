# Runtime only: enter real values in the hosting provider's Secret settings, never commit them.
NEOPULSE_MODE=live
NEOPULSE_SOURCE=ssi
NEOPULSE_DB_PATH=/data/neopulse.sqlite
NEOPULSE_UNIVERSE_INDEX=VN30
NEOPULSE_INDEXES=VNINDEX,VN30,HNXINDEX,UPCOMINDEX
NEOPULSE_FUTURES=
# Set to 1 only after verifying that /data survives a real container replacement.
NEOPULSE_PERSISTENCE_CONFIRMED=0
# Comma-separated exchange holiday dates; weekends are already excluded.
NEOPULSE_MARKET_HOLIDAYS=
SSI_API_KEY=
SSI_API_SECRET=
ABLY_API_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=
