# =====================================================================
#  NeoPulse Radar - tệp cấu hình mẫu
#  Cách dùng:  cp .env.example .env   rồi điền giá trị thật vào .env
#  TUYỆT ĐỐI không commit .env (đã có trong .gitignore).
# =====================================================================

# --- Chế độ dữ liệu ---------------------------------------------------
# sim  : dữ liệu MÔ PHỎNG (không cần tài khoản, luôn gắn nhãn "MÔ PHỎNG")
# live : NEO API thật (cần tài khoản đã được VPBankS gán quyền + đúng IP đăng ký)
NEOPULSE_MODE=sim

# --- [ĐIỀN Ở ĐÂY] Thông tin đăng nhập NEO API -------------------------
# Cách 1 (khuyến nghị): để chương trình tự đăng nhập và tự làm mới token
NEO_USERNAME=
NEO_PASSWORD=
# Cách 2: dán sẵn access_token (JWT, hết hạn sau ~3 giờ). Nếu có, sẽ được ưu tiên dùng trước.
NEO_ACCESS_TOKEN=

# --- Địa chỉ dịch vụ (theo tài liệu NEO API v1.0.0, kiểm tra lại khi triển khai)
NEO_AUTH_URL=https://external.vpbanks.com.vn/auth/token
NEO_BASE_URL=https://neoapi.vpbanks.com.vn/neo-api
NEO_WS_MARKET_URL=ws://neoapi.vpbanks.com.vn/stock-stream/broker
# Header bắt buộc của NEO API (định danh thiết bị - tự đặt, không phải bí mật)
NEO_DEVICE_ID=neopulse-radar
NEO_DEVICE_TYPE=Chrome
# Giới hạn tần suất phía client (NEO API: tối đa 5 request/giây). Để thấp hơn cho an toàn.
NEO_MAX_RPS=4

# --- Phạm vi theo dõi --------------------------------------------------
# Rổ cổ phiếu lấy thành phần qua /stock/stockDetailByIndex (VN30, HNX30, ...)
NEOPULSE_UNIVERSE_INDEX=VN30
# Bổ sung mã ngoài rổ (cách nhau bằng dấu phẩy), có thể để trống
NEOPULSE_EXTRA_SYMBOLS=
NEOPULSE_INDEXES=VNINDEX,VN30,HNXINDEX,UPCOMINDEX
NEOPULSE_DB_PATH=data/neopulse.sqlite

# --- [TÙY CHỌN] SSI FastConnect (nguồn bổ trợ, đề cho phép) ------------
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=

# --- [TÙY CHỌN] Gửi cảnh báo qua Telegram ------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- [TÙY CHỌN] Mô hình ngôn ngữ để diễn giải bản tin -------------------
# Để trống => dùng bộ diễn giải theo mẫu (không cần mạng, không có rủi ro bịa số).
LLM_API_KEY=
LLM_MODEL=
